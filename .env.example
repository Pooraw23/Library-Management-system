# Application Mode
# Set to 'false' to run with in-memory mock data (no PostgreSQL required)
# Set to 'true' to connect to PostgreSQL via psycopg2
USE_DB=false

# PostgreSQL Database Configuration (used when USE_DB=true)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USER=postgres
DB_PASSWORD=postgres

# Flask Session Security Key
SECRET_KEY=smartlib_dev_secret_key_change_in_production_2026
FLASK_DEBUG=true
